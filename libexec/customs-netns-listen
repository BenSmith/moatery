#!/usr/bin/python3
"""
customs-netns-listen: bind the inspector's two planes, or the responder's
port, in another process's network namespace, then become the program
with them.

    customs-netns-listen --pid PID -- customs-inspect ... --netns-pid PID
    customs-netns-listen --pid PID --resolver -- customs-resolve ...

PID is a process in the namespace, a rootless container's, whose user
namespace the user owns. A child joins it, binds 127.0.0.1:8443 and :8080
there (with --resolver, 127.0.0.1:8053 over UDP and TCP) and exits; this
process stays in the host's namespaces and execs the command with the
listeners as fds 3 onward, LISTEN_PID and LISTEN_FDS set. The lib module
is netns_listen.

Under a Type=notify unit it sends READY=1 once the listeners are bound,
before the exec, so a unit ordered after it (the workload's) starts only
when a connection can no longer be refused. SIGUSR1 is ignored from
then, across the exec: a reload the unit is sent before the command's
handler is in place is lost, not the end of the process.
"""

import argparse
import os
import signal
import sys

# Before the lib imports: the install directory is not this process's to
# write.
sys.dont_write_bytecode = True

from customs.netns_listen import (
    PLANE_LISTENERS, RESOLVER_LISTENERS, BindFailed, hand_over,
    listeners_in)
from customs.sd_notify import notify_ready


def parse_args(argv):
    parser = argparse.ArgumentParser(
        prog=os.path.basename(argv[0]),
        description="bind the inspector's or the responder's listeners "
                    "in another process's network namespace, then run a "
                    "command with them")
    parser.add_argument("--pid", type=int, required=True,
                        help="a process in the network namespace to bind in")
    parser.add_argument("--resolver", action="store_true",
                        help="bind the responder's port, UDP and TCP, "
                             "instead of the inspector's planes")
    parser.add_argument("command", nargs=argparse.REMAINDER,
                        help="the program to run with the listeners, "
                             "after --")
    args = parser.parse_args(argv[1:])
    if args.command[:1] == ["--"]:
        args.command = args.command[1:]
    if not args.command:
        parser.error("no command to run with the listeners")
    return args


def main(argv=None):
    argv = sys.argv if argv is None else argv
    try:
        args = parse_args(argv)
    except SystemExit as exc:
        return int(exc.code or 0)
    try:
        socks = listeners_in(args.pid, RESOLVER_LISTENERS if args.resolver
                             else PLANE_LISTENERS)
    except (OSError, BindFailed) as exc:
        print(f"error: cannot bind in pid {args.pid}'s network namespace: "
              f"{exc}", file=sys.stderr)
        return 1
    signal.signal(signal.SIGUSR1, signal.SIG_IGN)
    try:
        notify_ready()
    except OSError as exc:
        print(f"error: cannot tell the service manager the listeners are "
              f"bound: {exc}", file=sys.stderr)
        return 1
    try:
        hand_over(socks, args.command)
    except OSError as exc:
        print(f"error: cannot run {args.command[0]}: {exc}", file=sys.stderr)
    return 1


if __name__ == "__main__":
    sys.exit(main())
