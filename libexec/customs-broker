#!/usr/bin/env python3
"""
customs-broker -- a credential-holding reverse proxy for one workload.

The workload never receives a provider API key. It holds a placeholder,
sends its request as if the placeholder were the key, and the inspector
beside this broker forwards that request here rather than to the origin.
This broker looks the request's Host up in a table it built from its flags,
replaces the placeholder's header with the real credential, and sends the
request on over ordinary verified TLS from the host. The workload is never
told this broker's address, and the address is one it cannot reach.

Callers are identified by the uid owning the far end of the connection,
which the host assigns and nothing inside a workload can forge: read from
the socket table for a listener bound to an address, and from SO_PEERCRED
for one bound to a path (`--listen unix:PATH`, for a broker that shares a
network namespace with its workload and is kept from it by the mount
namespace instead). An instance serves ONE caller, whose uid it is told;
anyone else is refused. The one condition that makes that identification
fail without erroring -- a user namespace that cannot map the caller's uid,
which is what PrivateUsers= in a unit gives -- is refused at start, because
every unmapped caller reads as the overflow uid and they all look alike.

Deliberately NOT a general proxy. The upstream is fixed by the flags and is
never taken from the request, so a compromised workload cannot steer this
at anything else. A broker that forwarded to a workload-chosen destination
would be an SSRF pivot with a credential welded to it -- the exact failure
this design exists to avoid.

stdlib only. This file is the entrypoint: the profile table is
broker_profiles', the request path broker_request's, the server
broker_server's, and the caller identification peer_identity's.

EVERYTHING IT KNOWS, IT IS TOLD. The flags below are the whole of what the
broker needs and none of it is derived here: whoever writes the unit is the
one place a workload becomes a uid, a listen address and a set of
credential ids, and writes them onto ExecStart=. This program imports
nothing that reads a workload's config, knows where one keeps its things,
or turns a uid into anything; tests/test_closure.py holds it to that. The
material itself never appears on the command line: it arrives under
$CREDENTIALS_DIRECTORY from the unit's LoadCredentialEncrypted= lines, and
a --host flag names the credential id the unit loaded it under.

Usage:
  customs-broker --name NAME --listen ADDRESS:PORT|unix:PATH
                 --caller-uid UID
                 --host HOST=CREDENTIAL [--host ...]
                 [--placeholder CREDENTIAL=TEXT]
                 [--auth-header CREDENTIAL=FIELD]
                 [--auth-format CREDENTIAL=FORMAT]
                 [--tls-cert PATH --tls-key PATH] [--relax-x509-strict]
                 [--connect-timeout SECONDS] [--read-timeout SECONDS]
"""

import argparse
import os
import sys
from pathlib import Path

# Before the lib imports, for the reason customs-inspect gives.
sys.dont_write_bytecode = True

from broker_profiles import (
    BrokerConfigError, build_profiles, listen_endpoint,
)
from broker_server import (
    CONNECT_TIMEOUT, READ_TIMEOUT, Handler, guest_tls_context, listening_url,
    log, make_server, upstream_tls_context,
)
from peer_identity import overflow_uid, unmappable_uids, userns_maps_everything


def parse_args(argv):
    """The flags. Every required one is a value the broker cannot derive;
    every optional one has a default a unit that names none can live
    with."""
    p = argparse.ArgumentParser(
        prog="customs-broker",
        description="credential-holding reverse proxy for one workload")
    p.add_argument("--name", required=True,
                   help="the workload's name: a label for the log lines")
    p.add_argument("--listen", required=True,
                   metavar="ADDRESS:PORT|unix:PATH",
                   help="the address this instance alone binds, or a socket "
                        "path it alone has")
    p.add_argument("--caller-uid", required=True, type=int, metavar="UID",
                   help="the one uid whose connections are served")
    p.add_argument("--host", action="append", default=[],
                   metavar="HOST=CREDENTIAL",
                   help="a Host this instance holds a credential for, and the "
                        "credential id (the name under "
                        "$CREDENTIALS_DIRECTORY) "
                        "it attaches; repeatable")
    p.add_argument("--placeholder", action="append", default=[],
                   metavar="CREDENTIAL=TEXT",
                   help="the fiction the guest holds in place of that "
                        "credential; refused if it equals the real one")
    p.add_argument("--auth-header", action="append", default=[],
                   metavar="CREDENTIAL=FIELD",
                   help="the header the credential is sent in "
                        "(default x-api-key)")
    p.add_argument("--auth-format", action="append", default=[],
                   metavar="CREDENTIAL=FORMAT",
                   help="the header value, with {secret} substituted "
                        "(default {secret})")
    p.add_argument("--tls-cert", metavar="PATH",
                   help="serve HTTPS to the caller with this certificate")
    p.add_argument("--tls-key", metavar="PATH")
    p.add_argument("--relax-x509-strict", action="store_true",
                   help="clear VERIFY_X509_STRICT for a private upstream CA "
                        "missing keyUsage; verification otherwise unchanged")
    p.add_argument("--connect-timeout", type=float, default=CONNECT_TIMEOUT,
                   metavar="SECONDS")
    p.add_argument("--read-timeout", type=float, default=READ_TIMEOUT,
                   metavar="SECONDS")
    args = p.parse_args(argv[1:])
    if bool(args.tls_cert) != bool(args.tls_key):
        p.error("--tls-cert and --tls-key go together")
    return args


def main(argv=None):
    argv = sys.argv if argv is None else argv
    args = parse_args(argv)
    try:
        addr = listen_endpoint(args.listen)
    except BrokerConfigError as exc:
        sys.exit(str(exc))

    # Refuse to run somewhere identification cannot work. From a user namespace
    # that does not map the caller's uid, that caller reads as the overflow uid
    # -- which raises nothing, it just merges sandboxes into one identity. In a
    # unit this means PrivateUsers= must stay unset; the rest of the hardening
    # set is unaffected.
    try:
        uid_map = Path("/proc/self/uid_map").read_text()
    except OSError as exc:
        sys.exit(f"cannot read /proc/self/uid_map ({exc.strerror}); caller "
                 "identification needs it")
    if unmappable_uids([args.caller_uid], uid_map):
        sys.exit(f"this user namespace cannot represent uid "
                 f"{args.caller_uid} ({args.name}) -- its connections would "
                 "be indistinguishable from any other unmapped caller's. "
                 "Unset PrivateUsers= in the unit")
    if not userns_maps_everything(uid_map):
        # The one caller checked out, but every other uid might still land
        # outside the map, and that failure is silent.
        log("warn", msg="running in a user namespace; callers outside its uid "
                        "map cannot be identified")

    if (not os.environ.get("CREDENTIALS_DIRECTORY")
            and os.environ.get("CUSTOMS_BROKER_SECRET")):
        log("warn", msg="using CUSTOMS_BROKER_SECRET; prefer systemd "
                        "LoadCredentialEncrypted=")
    try:
        Handler.profiles = build_profiles(
            args.name, args.host, args.placeholder, args.auth_header,
            args.auth_format)
    except BrokerConfigError as exc:
        sys.exit(str(exc))
    Handler.name = args.name
    Handler.workload_uid = args.caller_uid
    Handler.overflow = overflow_uid()
    Handler.upstream_context = upstream_tls_context(args.relax_x509_strict)
    Handler.connect_timeout = args.connect_timeout
    Handler.read_timeout = args.read_timeout

    server = make_server(addr, Handler)
    server.guest_tls_context = guest_tls_context(args.tls_cert, args.tls_key)
    scheme = "https" if server.guest_tls_context else "http"

    log("listening", url=listening_url(addr, scheme),
        workload=args.name, uid=args.caller_uid,
        hosts=len(Handler.profiles), unknown="refused")
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        log("shutdown")


if __name__ == "__main__":
    main()
