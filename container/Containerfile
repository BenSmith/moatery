# The sidecar image: the programs, the moatery package beside them, and
# moat-sidecar as the entrypoint. Build from the checkout root:
#
#   podman build -t moat-sidecar -f container/Containerfile .
#
# Two users, one group. The inspector (uid 200) parses what the workload
# sends and owns the state volume, and the responder runs as it too; the
# broker (uid 201) holds the key and owns the socket directory; the group
# is how the inspector reaches the socket and nothing else of the
# broker's. The numbers are fixed so that `--secret ...,uid=201` and the
# pod's `meta skuid` rules can name them.

FROM registry.fedoraproject.org/fedora-minimal:44

RUN dnf -y --setopt=install_weak_deps=False install \
        python3 openssl shadow-utils \
    && dnf clean all \
    && groupadd -r -g 200 moatery \
    && useradd -r -u 200 -g moatery -d /var/lib/moatery -M \
        -s /usr/sbin/nologin inspect \
    && useradd -r -u 201 -g moatery -d /nonexistent -M \
        -s /usr/sbin/nologin broker \
    && mkdir -p /etc/moatery /var/lib/moatery

COPY libexec/ container/moat-sidecar /usr/libexec/moatery/
COPY moatery/ /usr/libexec/moatery/moatery/

VOLUME /var/lib/moatery
ENTRYPOINT ["/usr/libexec/moatery/moat-sidecar"]
