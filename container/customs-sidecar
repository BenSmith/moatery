#!/usr/bin/python3
"""
customs-sidecar: the entrypoint of the sidecar image. It is the unit file
for both programs, written as the one process a container starts with.

The image carries customs-broker and customs-inspect side by side with
lib/. This process, as the container's root, does what the two units and
the socket unit do on a host, and nothing the programs do themselves:

  - binds the inspector's two planes on the pod's loopback and hands them
    down as inherited fds, LISTEN_PID/LISTEN_FDS style. The inspector
    never binds; here the bind is root's, before any privilege is dropped,
    which is the same property the socket unit holds on a host.
  - starts the broker as its own uid, listening on a socket path under
    /run/customs that the workload container has no mount for. The
    broker's caller is the inspector's uid, and no other.
  - hands the state volume to the inspector's uid, and mints the egress
    CA into it on the first start, as that uid, so the workload's trust
    bundle can be built from it.
  - starts the inspector as its own uid with the planes as fds 3 and 4,
    told the workload's uid so that it serves the one caller the pod's
    rules redirect into it.
  - stays, as the container's pid 1, to supervise the two. See
    SUPERVISION.

Two uids in one container is the privilege boundary: the inspector parses
what the workload sends and holds no key; the broker holds the key and
parses only what the inspector forwards. Dropping to a uid clears every
capability, so no DAC_OVERRIDE bridges them.

EVERYTHING ELSE IS TOLD. The two flags this takes are the two facts the
image cannot know -- the workload's label and its uid -- and every flag
after them is the broker's, passed through untouched: which hosts, which
credential ids, which placeholders. The credential material is mounted at
/run/secrets by whoever runs the container, which is the pod's
LoadCredentialEncrypted=.

Usage:
  customs-sidecar --name NAME --caller-uid UID [BROKER FLAGS...]

  podman run --pod POD --restart on-failure \\
      --cap-drop all --cap-add chown,dac_override,setgid,setuid \\
      -v policy.json:/etc/customs/policy.json:ro,Z \\
      -v customs-state:/var/lib/customs:Z \\
      --secret KEY,target=CRED,uid=201,mode=0400 \\
      IMAGE --name NAME --caller-uid UID --host HOST=CRED ...

The four capabilities are this process's, for the chown of the two
directories, the connect that sees the broker listening on its 0660
socket, and the drops; setuid() clears them all,
so neither program holds one, and nor does this process once both have
started.

SUPERVISION

The pair serves together or not at all, and a container is restarted
whole, so the container ends when either program does. This process
waits on both. A stop is forwarded to both, and the container exits 0
once both have exited. If a program exits unasked, the other is stopped
(SIGKILL after STOP_GRACE) and the container exits 1, which is what a
restart policy acts on. A broker left dead under a live inspector would
keep the container up with every brokered request refused.

To signal both without CAP_KILL, this process ends with the inspector's
uid as its real uid and the broker's as its effective and saved uid.
kill() is allowed where the sender's real or effective uid is the
target's real uid, so both are in reach, and with no uid 0 left every
capability is cleared. Either program can signal this process, which
only ends the container.

It is pid 1 for the same reason, and refuses to start as anything else.
The runtime delivers a stop to pid 1 from outside the container, where
uids are no barrier. An init such as --init's runs as root without
CAP_KILL and cannot signal a process whose uids are not 0, so its stop
never arrived and the stop timeout's SIGKILL ended every run. As pid 1
this process also reaps whatever the programs orphan.
"""

import argparse
import grp
import os
import pwd
import signal
import socket
import sys
import time
from pathlib import Path

sys.dont_write_bytecode = True

import egress_mint
from egress_plane import CLEARTEXT, TLS

HERE = Path(__file__).resolve().parent
BROKER = HERE / "customs-broker"
INSPECTOR = HERE / "customs-inspect"

INSPECT_USER = "inspect"
BROKER_USER = "broker"
GROUP = "customs"

POLICY = "/etc/customs/policy.json"
STATE = "/var/lib/customs"
STATUS = f"{STATE}/status.json"
RECORD = f"{STATE}/egress.jsonl"
RUN_DIR = "/run/customs"
SOCKET = f"{RUN_DIR}/broker.sock"
SECRETS = "/run/secrets"

LOOPBACK = "127.0.0.1"
PLANES = (TLS.inspect_port, CLEARTEXT.inspect_port)
# The first inherited fd, by the activation convention the inspector reads.
LISTEN_FDS_START = 3

# The environment the two programs get, and nothing else of this one's.
# Whatever the container was started with -- a secret passed as a
# variable included -- would otherwise reach the inspector, the uid that
# parses the workload's bytes. PATH finds openssl; the rest is locale and
# trust-store placement the programs may honour.
PROGRAM_ENV = ("PATH", "LANG", "LC_ALL", "TZ", "SSL_CERT_FILE",
               "SSL_CERT_DIR")
DEFAULT_PATH = "/usr/sbin:/usr/bin"

# How long the broker gets to put its socket at the path before the
# inspector is started; past it the container fails rather than serving a
# workload whose brokered requests all 502.
BROKER_START_TIMEOUT = 10.0

# How long a program gets to exit on SIGTERM before SIGKILL, once the
# other has exited or a stop has arrived. Under podman's default stop
# timeout, so a stop ends here rather than in the runtime's SIGKILL.
STOP_GRACE = 5.0


def parse_args(argv):
    """The two facts the image cannot know, and the broker's flags after.

    parse_known_args so the broker's vocabulary is not repeated here: a
    flag the broker grows is passed through without this file changing.
    The broker's own --listen and --caller-uid are this file's to set and
    are refused if given, since a second --listen would win the parser and
    put the broker on an address the pod can reach.
    """
    p = argparse.ArgumentParser(
        prog="customs-sidecar",
        description="the pair, as a pod sidecar")
    p.add_argument("--name", required=True,
                   help="the workload's label, for both programs")
    p.add_argument("--caller-uid", required=True, type=int, metavar="UID",
                   help="the workload's uid in the pod: the one caller the "
                        "inspector serves")
    args, broker_flags = p.parse_known_args(argv[1:])
    for flag in ("--listen", "--caller-uid", "--name"):
        if any(f == flag or f.startswith(flag + "=") for f in broker_flags):
            p.error(f"{flag} is this entrypoint's to set, not the broker's")
    if not broker_flags:
        p.error("the broker's flags follow: at least one --host HOST=CRED")
    return args, broker_flags


def broker_argv(name, flags):
    return [sys.executable, str(BROKER), "--name", name,
            "--listen", f"unix:{SOCKET}",
            "--caller-uid", str(pwd.getpwnam(INSPECT_USER).pw_uid),
            *flags]


def inspector_argv(name, caller_uid):
    return [sys.executable, str(INSPECTOR), "--name", name,
            "--policy", POLICY, "--state-dir", STATE,
            "--status", STATUS, "--record", RECORD,
            "--broker", f"unix:{SOCKET}",
            "--caller-uid", str(caller_uid)]


def bind_planes():
    """The two listeners, bound here as root and handed down as fds 3 and
    4. Non-blocking is not set: the inspector's accept loop selects on
    them and expects a blocking accept."""
    sockets = []
    for port in PLANES:
        s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        s.bind((LOOPBACK, port))
        s.listen(128)
        sockets.append(s)
    return sockets


def prepare_dirs(inspect, broker, group):
    """The run directory for the socket and the state volume for the CA
    and the caches, each owned by the uid that writes there. The socket
    directory is the broker's and the inspector traverses it by group,
    which is how a path can be dialled but not created or removed by the
    side that parses the workload's bytes."""
    for path, owner in ((Path(RUN_DIR), broker), (Path(STATE), inspect)):
        path.mkdir(mode=0o750, exist_ok=True)
        # Root's before the chmod: on a restart the directory is already
        # the owner's, and chmod on another uid's file needs CAP_FOWNER,
        # which the container need not hold. chown needs CAP_CHOWN only.
        os.chown(path, 0, 0)
        path.chmod(0o750)
        os.chown(path, owner.pw_uid, group.gr_gid)


def mint_ca(name, inspect, group):
    """Once, into the volume, on the first start, as the inspector's uid.
    The inspector refuses to start under a policy that inspects with no CA
    to mint from, and a volume that starts empty is the ordinary first run.
    The mint is egress_mint's, the one customs-mint-ca makes on a host.

    Not as root. The volume is the inspector's and outlives every restart,
    so anything under it is the inspector's to arrange: a root that
    minted into it and then chowned what it wrote would follow whatever
    the inspector left there. In a child that has dropped to the
    inspector's uid, the mint can reach only what that uid already can.
    """
    pid = os.fork()
    if pid == 0:
        code = MINT_FAILED
        try:
            become(inspect, group)
            code = MINT_MINTED if egress_mint.mint_ca(name, STATE) \
                else MINT_KEPT
        except egress_mint.MintFailed as exc:
            print(f"could not mint the egress CA: {exc}", file=sys.stderr,
                  flush=True)
        except BaseException as exc:
            print(f"could not mint the egress CA: {exc!r}", file=sys.stderr,
                  flush=True)
        finally:
            os._exit(code)
    _, status = os.waitpid(pid, 0)
    code = os.waitstatus_to_exitcode(status)
    if code == MINT_MINTED:
        return True
    if code == MINT_KEPT:
        return False
    raise egress_mint.MintFailed(f"the mint exited with status {code}; its "
                                 "reason is above")


# The mint child's answer, as its exit status.
MINT_MINTED, MINT_KEPT, MINT_FAILED = 0, 10, 11


def program_env(**extra):
    """The environment a program is started with: PROGRAM_ENV from this
    one, a PATH whatever this one had, and `extra`."""
    env = {k: os.environ[k] for k in PROGRAM_ENV if k in os.environ}
    env.setdefault("PATH", DEFAULT_PATH)
    return {**env, **extra}


def become(user, group):
    """Drop to `user`, with `group` as the primary group and nothing
    supplementary. Order matters: groups first, while still root."""
    os.setgroups([])
    os.setgid(group.gr_gid)
    os.setuid(user.pw_uid)


def start_broker(name, flags, broker, group, sockets):
    """Fork the broker as its uid. The child closes the planes before it
    execs: they are the inspector's, and a broker holding them open would
    keep the ports bound after the inspector went away."""
    pid = os.fork()
    if pid == 0:
        try:
            for s in sockets:
                s.close()
            become(broker, group)
            env = program_env(CREDENTIALS_DIRECTORY=SECRETS)
            os.execve(sys.executable, broker_argv(name, flags), env)
        finally:
            os._exit(127)
    return pid


def await_socket(pid):
    """The broker listening at its path, or its exit status if it died.

    Listening, not merely bound: the file appears at bind(), before the
    broker's listen(), and an inspector started in between has its first
    brokered request refused. A connect that succeeds is the broker
    accepting; it is closed without a byte, which the broker ends quietly.
    """
    deadline = time.monotonic() + BROKER_START_TIMEOUT
    while time.monotonic() < deadline:
        done, status = os.waitpid(pid, os.WNOHANG)
        if done:
            return False, os.waitstatus_to_exitcode(status)
        if Path(SOCKET).is_socket() and _accepts(SOCKET):
            return True, None
        time.sleep(0.05)
    return False, None


def _accepts(path):
    probe = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    try:
        probe.connect(path)
    except OSError:
        return False
    finally:
        probe.close()
    return True


def start_inspector(name, caller_uid, inspect, group, sockets):
    """Fork the inspector as its uid: fds moved to 3.., made inheritable,
    LISTEN_PID naming the child, which exec keeps."""
    pid = os.fork()
    if pid == 0:
        try:
            for i, s in enumerate(sockets):
                fd = LISTEN_FDS_START + i
                if s.fileno() != fd:
                    os.dup2(s.fileno(), fd)
                os.set_inheritable(fd, True)
            become(inspect, group)
            env = program_env(LISTEN_PID=str(os.getpid()),
                              LISTEN_FDS=str(len(sockets)))
            os.execve(sys.executable, inspector_argv(name, caller_uid), env)
        finally:
            os._exit(127)
    return pid


def become_supervisor(inspect, broker, group):
    """The uids SUPERVISION describes: real the inspector's, effective
    and saved the broker's. No uid is 0 afterwards, so the kernel clears
    every capability."""
    os.setgroups([])
    os.setresgid(group.gr_gid, group.gr_gid, group.gr_gid)
    os.setresuid(inspect.pw_uid, broker.pw_uid, broker.pw_uid)


def supervise(children, stopping):
    """Wait on {pid: name} until every one has exited, and return the
    container's exit status: 0 after a stop, 1 if a program exited unasked.

    `stopping` is a list a signal handler appends to; whichever comes
    first, a stop or an exit, the rest get SIGTERM and STOP_GRACE.
    Any other pid is an orphan reparented here, reaped and ignored.
    """
    unasked = False
    deadline = None

    def end_all(sig):
        for pid in children:
            try:
                os.kill(pid, sig)
            except ProcessLookupError:
                pass

    while children:
        if deadline is None and stopping:
            end_all(signal.SIGTERM)
            deadline = time.monotonic() + STOP_GRACE
        # Polled: a blocking wait is resumed after the handler runs, so a
        # stop would wait on an exit that only the stop can cause.
        pid, status = os.waitpid(-1, os.WNOHANG)
        if pid == 0:
            if deadline is not None and time.monotonic() >= deadline:
                end_all(signal.SIGKILL)
            time.sleep(0.1)
            continue
        name = children.pop(pid, None)
        if name is None:
            continue
        code = os.waitstatus_to_exitcode(status)
        print(f"the {name} exited ({code})", file=sys.stderr, flush=True)
        if not stopping:
            unasked = True
            stopping.append(None)
    return 1 if unasked else 0


def main(argv=None):
    argv = sys.argv if argv is None else argv
    args, broker_flags = parse_args(argv)
    if os.getuid() != 0:
        sys.exit("customs-sidecar starts as the container's root and drops "
                 "to the image's two users; run the container as root")
    try:
        inspect = pwd.getpwnam(INSPECT_USER)
        broker = pwd.getpwnam(BROKER_USER)
        group = grp.getgrnam(GROUP)
    except KeyError as exc:
        sys.exit(f"the image lacks its user: {exc}")
    # The pod's rules exempt the two programs' uids from the redirect, and
    # root can become either: a workload running as any of the three is
    # never inspected at all.
    if args.caller_uid in (0, inspect.pw_uid, broker.pw_uid):
        sys.exit(f"--caller-uid {args.caller_uid} is root or one of this "
                 f"image's own uids ({inspect.pw_uid}, {broker.pw_uid}), "
                 "whose traffic the pod's rules exempt; run the workload "
                 "as another uid")
    if os.getpid() != 1:
        sys.exit("customs-sidecar supervises both programs as the "
                 "container's pid 1; run the container without --init")
    if not Path(POLICY).exists():
        sys.exit(f"no policy at {POLICY}; mount one (ro)")

    prepare_dirs(inspect, broker, group)
    try:
        if mint_ca(args.name, inspect, group):
            print(f"egress CA minted into {STATE}", file=sys.stderr,
                  flush=True)
    except egress_mint.MintFailed as exc:
        sys.exit(f"could not mint the egress CA: {exc}")
    sockets = bind_planes()
    # /run survives a container restart. A socket the last broker left
    # would read as this one listening before it has bound.
    Path(SOCKET).unlink(missing_ok=True)
    stopping = []
    signal.signal(signal.SIGTERM, lambda signum, _: stopping.append(signum))
    signal.signal(signal.SIGINT, lambda signum, _: stopping.append(signum))
    pid = start_broker(args.name, broker_flags, broker, group, sockets)
    up, status = await_socket(pid)
    if not up:
        if status is None:
            sys.exit(f"the broker did not listen at {SOCKET} within "
                     f"{BROKER_START_TIMEOUT:.0f}s")
        sys.exit(f"the broker exited with status {status} before "
                 "listening; its reason is above")
    children = {pid: "broker"}
    children[start_inspector(args.name, args.caller_uid, inspect, group,
                             sockets)] = "inspector"
    for s in sockets:
        s.close()
    become_supervisor(inspect, broker, group)
    sys.exit(supervise(children, stopping))


if __name__ == "__main__":
    main()
