#!/usr/bin/python3
"""
customs-box: long-lived, inspected containers for command-line
workloads (docs/BOX.md).

Each box is a quadlet pod holding a network namespace, the customs
rules loaded into it at every start, the inspector's and the
responder's listeners bound in it, and a workload started after them,
with a home of its own; and, if its policy names credentials, a broker
holding them. The units run the programs from $CUSTOMS_LIBEXEC,
/usr/libexec/customs by default, and call back into this command
(`customs-box unit ...`) for what they cannot say themselves.

Usage:
  customs-box create NAME --policy FILE [--image IMAGE]
                     [--mount SRC[:DST][:ro]]...
  customs-box enter NAME [--root] [-- COMMAND...]
  customs-box log NAME [--refused]
  customs-box allow NAME HOST [--method M]... [--path P]...
  customs-box policy NAME
  customs-box stop NAME
  customs-box rm NAME [--home]
  customs-box ls
  customs-box credential add ID [--host HOST]... [--env VARIABLE]
                     [--auth-header FIELD] [--auth-format FORMAT]
  customs-box credential ls
  customs-box credential rm ID
"""

import sys

# Before the package imports, for the reason customs-inspect gives.
sys.dont_write_bytecode = True

from customs_box.cli import main

if __name__ == "__main__":
    sys.exit(main())
