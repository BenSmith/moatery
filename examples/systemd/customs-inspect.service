# The egress inspector, started by customs-inspect.socket on the first
# connection. `systemctl --user reload` applies a policy edit without
# cutting a connection; a change of "tls" needs a restart. It refuses to start without the CA under %S/customs/ca, which
# customs-mint-ca makes (examples/README.md).

[Unit]
Description=customs egress inspector
Requires=customs-inspect.socket
Wants=customs-broker.service
After=customs-broker.service

[Service]
ExecStart=/usr/libexec/customs/customs-inspect --name example \
    --policy %E/customs/policy.json \
    --state-dir %S/customs \
    --status %S/customs/status.json \
    --record %L/customs/requests.log \
    --broker unix:%t/customs/broker.sock
ExecReload=kill -USR1 $MAINPID
StateDirectory=customs
LogsDirectory=customs
