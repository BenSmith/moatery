# Rotates the inspector's record as this user; started by
# customs-logrotate.timer. The configuration is
# examples/logrotate/customs.conf, copied to %E/customs/logrotate.conf.

[Unit]
Description=Rotate the customs request record

[Service]
Type=oneshot
ExecStart=logrotate --state %S/customs/logrotate.state \
    %E/customs/logrotate.conf
