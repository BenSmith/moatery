# The responder's port, over UDP and TCP. Bound here, by systemd, and
# handed to the responder; it never binds a socket itself. The netns rule
# redirects the workload's port 53 here.

[Unit]
Description=customs DNS responder listeners

[Socket]
ListenDatagram=127.0.0.1:8053
ListenStream=127.0.0.1:8053

[Install]
WantedBy=sockets.target
