# The workload's nameserver, started by customs-resolve.socket on the
# first query. Every name is answered with the address the workload's
# 443 and 80 are redirected from, and nothing is forwarded. The policy is
# the inspector's, read once to count unlisted names; restart it with the
# inspector to apply an edit.

[Unit]
Description=customs DNS responder
Requires=customs-resolve.socket

[Service]
ExecStart=/usr/libexec/customs/customs-resolve --name example \
    --address 169.254.1.3 \
    --policy %E/customs/policy.json \
    --status %S/customs/resolve-status.json
StateDirectory=customs
