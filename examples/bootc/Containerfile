# A bootc image with moatery and what it recommends. The build context
# is this directory, with the RPM from `just rpm` copied in as
# moatery.rpm:
#
#   podman build -t moatery-bootc examples/bootc
#
# The lint is the build's gate: without --fatal-warnings it exits 0 on
# a warning. It is run with no --skip, so nothing the dnf layer leaves
# under /var or /run may survive it.

ARG BASE=quay.io/fedora/fedora-bootc:44
FROM $BASE
COPY moatery.rpm /tmp/moatery.rpm
RUN dnf -y install --setopt=install_weak_deps=True /tmp/moatery.rpm \
        podman passt nftables \
    && dnf clean all && rm -f /tmp/moatery.rpm \
    && rm -rf /var/log/* /var/cache/* /var/lib/dnf/* /run/dnf
RUN bootc container lint --fatal-warnings
