# The rigs' layer over the image above: ip for the rigs, and sudo
# without a password for wheel. For a test VM only.
#
#   podman build -t moatery-bootc:rig --build-arg IMAGE=moatery-bootc \
#       -f examples/bootc/Containerfile.rig examples/bootc

ARG IMAGE
FROM $IMAGE
RUN dnf -y install iproute sudo && dnf clean all \
    && echo "%wheel ALL=(ALL) NOPASSWD: ALL" > /etc/sudoers.d/rig \
    && chmod 0440 /etc/sudoers.d/rig
